# KamerWear environment overview.
# Each app reads its own env file. This file only shows what goes where.
#
# Backend:  copy backend/.env.example to backend/.env and fill it in.
#
# Frontend: create frontend/.env.local (next to package.json, not inside src/)
#           containing the variable below. NEXT_PUBLIC_* values are inlined
#           into the browser bundle at build time, so never put secrets in them.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional (frontend, server-only): auth cookies are Secure (HTTPS-only) when
# NODE_ENV=production. Set to false only to try a production build over plain
# http://localhost; never in a real deployment.
# AUTH_COOKIE_SECURE=false
