# Copy this file to backend/.env and replace the placeholders.
# Never commit backend/.env.

# PostgreSQL connection (SQLAlchemy URL using the psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/kamerwear

# Frontend origins allowed to call the API, comma-separated. Never use "*".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication. Required for login/registration. Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Token lifetimes (defaults shown).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Hosts allowed to send X-Forwarded-For (the local Next.js server). Comma-separated.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Visual search (optional; needs requirements-visual-search.txt). Defaults shown.
# VISUAL_SEARCH_MODEL=ViT-B-32
# VISUAL_SEARCH_PRETRAINED=laion2b_s34b_b79k
# Folder containing images/products/... (the frontend public folder).
# VISUAL_SEARCH_IMAGE_ROOT=../frontend/public
# VISUAL_SEARCH_CACHE_DIR=.model-cache
# Set to true after `python -m app.ai.prepare_visual_search` to never download.
# VISUAL_SEARCH_OFFLINE=false

# Smart Fit (optional; needs requirements-smart-fit.txt). The API never downloads:
# run `python -m app.ai.prepare_smart_fit` once. Default shown.
# SMART_FIT_MODEL_PATH=.model-cache/smart-fit/pose_landmarker_heavy.task

# Demo accounts used by `python -m app.db.reset_demo --yes` and
# `python -m app.demo.healthcheck`. Set them in your shell or here (never commit
# real values). Without them, the reset creates no usable logins.
# DEMO_ADMIN_EMAIL=admin@example.com
# DEMO_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_PASSPHRASE
# DEMO_CUSTOMER_EMAIL=customer@example.com
# DEMO_CUSTOMER_PASSWORD=CHANGE_ME_TO_A_LONG_PASSPHRASE
