# Copy this file to backend/.env and replace the placeholders.
# Never commit backend/.env.

# PostgreSQL connection (SQLAlchemy URL using the psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/kamerwear

# Frontend origins allowed to call the API, comma-separated. Never use "*".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication. Required for login/registration. Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Token lifetimes (defaults shown).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Hosts allowed to send X-Forwarded-For (the local Next.js server). Comma-separated.
TRUSTED_PROXY_IPS=127.0.0.1,::1
